# Postgres connection string(s) read by lib/db.ts. Real values live only in
# Vercel's project environment-variable settings and in a local .env.local
# that .gitignore excludes — never commit an actual connection string.
#
# Both names are accepted (DATABASE_URL wins if both are set) because
# Vercel's own Postgres/storage integrations have not used a single
# consistent env var name across product iterations; whichever name the
# provisioned integration actually injects will work without code changes.
DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_URL=postgresql://user:password@host:5432/dbname
